# Copie este arquivo para ".env" (raiz) e para "config/.env" e preencha os valores.

# Chave gratuita da OpenWeatherMap: https://openweathermap.org/api
API_KEY=sua_chave_aqui

# Banco de dados onde os dados do clima serão gravados
DB_HOST=postgres
DB_NAME=weather
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Só no Linux: rode "id -u" no terminal e coloque o número aqui
AIRFLOW_UID=1000